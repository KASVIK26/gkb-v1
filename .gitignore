# Secrets (.env.example is committed as the template)
.env
.env.*
!.env.example

# Cloudflare Pages Functions local-dev secrets (wrangler pages dev reads this)
.dev.vars

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-*/
venv/

# Data: raw downloads and intermediates are never committed.
# Only small checksum manifests are tracked.
data/*
!data/manifests/

# Local tooling state
.wrangler/
.claude/
pipeline_run_log.txt

# Downloaded bioinformatics binaries (NCBI BLAST+) -- not committed, ~370MB extracted.
.tools/

# Intermediate output of `agrihub kg ingest-candidates` (verified batches awaiting a human spot-check)
kg/incoming/
batches/

# large unpublished genotype data shared by ICAR-IISR Indore (never committed)
icar_soybean_files/
