# Copy to .env and fill in. Never commit .env.

# Legacy v1 graph (Neo4j Aura). Replaced by DATABASE_URL (Postgres) in Phase 2.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# LLM providers (the v1 extractor uses GROQ_API_KEY)
GROQ_API_KEY=
GEMINI_API_KEY=
OPEN_ROUTER_API_KEY=

# Supabase (Phase 2). Use the Supavisor pooler strings (the direct host is IPv6-only):
#   DATABASE_URL        = transaction pooler, port 6543 (API)
#   DATABASE_URL_DIRECT = session pooler, port 5432 (migrations, COPY bulk loads)
DATABASE_URL=
DATABASE_URL_DIRECT=
SUPABASE_URL=
# Publishable/anon key: safe for the frontend.
SUPABASE_PUBLISHABLE_KEY=
# Secret/service-role key: server-side only. Never ship it to the frontend.
SUPABASE_SECRET_KEY=

# Tests: optional Postgres URL for the CQ/DDL tests. Default is a throwaway local cluster.
TEST_DATABASE_URL=
